HOST=0.0.0.0
PORT=3080
RECAP_DIR=data/recaps
CHESS_DIFFICULTY=normal
# See docs/API-CONFIGURATION.md. Choose api, codex, gateway (legacy), or demo.
AI_MODE=api
AI_API_FORMAT=chat
# Remote API: replace the example hostname, model ID and token with provider values.
# AI_URL is the complete POST endpoint, not a base URL.
AI_URL=https://api.example.com/v1/chat/completions
AI_MODEL=YOUR_MODEL_ID
AI_TOKEN=
# Alternatively a readable file containing only the token (takes precedence).
AI_TOKEN_FILE=
AI_PROFILE=
AI_TIMEOUT_MS=180000
CODEX_COMMAND=codex
# Optional path to the npm CLI's bin/codex.js (launched with Node).
CODEX_JS_PATH=
# Local Codex only: model-supported none/minimal/low/medium/high/xhigh.
AI_REASONING_EFFORT=
# Local CLI setup: change AI_MODE=codex and AI_MODEL=default.
# API URL/token/profile are ignored in codex mode. Run codex login first.
